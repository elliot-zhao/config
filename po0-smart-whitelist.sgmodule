#!name=po0 防火墙（按节点自动查询与加白）
#!desc=换网络、启动和定时检查时，上次检查以来走过指定节点才自动加白；可按 Wi-Fi、蜂窝排除，并遵守 SSID Setting 挂起。「po0 手动加白」不受这些限制，先查后加。
#!category=po0
#!arguments=tokens:"",fallback_enabled:1,fallback_minutes:30,fallback_hours:0,exclude_ssids:"",exclude_cellular:0,show_network_panel:1,node_names:"",node_keywords:""
#!arguments-desc=【基本】\ntokens：po0 防火墙 token，多个用英文逗号分隔；固定槽位在末尾加 @0～@4\n\n【定时兜底】\nfallback_enabled：1 开启，0 关闭（关闭后下面两项不生效）\nfallback_minutes：每隔几分钟检查一次，0～59，默认 30；大于 0 时优先\nfallback_hours：分钟为 0 时，每隔几小时检查一次，0～23，默认 0\n例：每 1 小时 → 分钟 0、小时 1；两项都为 0 → 关闭\n\n【不自动加白的网络】\nexclude_ssids：Wi-Fi 完整名称，多个用 | 分隔；名称太长或含 | 和英文双引号时，用「po0 网络排除」面板添加\nexclude_cellular：1 蜂窝网络不自动加白，0 不限制；面板不能改蜂窝\nshow_network_panel：1 显示「po0 网络排除」面板，0 隐藏\nSSID Setting 中 suspend=true 的网络始终不自动加白，优先级最高\n\n【节点过滤】\nnode_names：节点完整名称，多个用 | 分隔\nnode_keywords：节点名称关键词，多个用 | 分隔\n上次检查以来走过命中的节点才自动加白；两项都不填则不过滤\n\n【手动加白】\n「po0 手动加白」不看节点、SSID Setting 和排除名单；已在白名单时不重复添加
#!requirement=CORE_VERSION>=6009000

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-firewall-network = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=auto&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
po0-firewall-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=auto&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
po0-firewall-status = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=status&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
po0-firewall-add = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=add&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
po0-firewall-network-toggle = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=network_toggle&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
po0-firewall-clear-network-exclusions = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&action=network_clear&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
# 开关为 0 时两条规则均禁用；开启后分钟优先，分钟为 0 才启用小时；两者为 0 时均禁用。
# REQUIREMENT 条件为假时，该行不启动定时任务；没有额外的每分钟检查。
#!REQUIREMENT "{{{fallback_enabled}}}=1 AND {{{fallback_minutes}}}>0 AND {{{fallback_minutes}}}<60" po0-firewall-timer-minutes = type=cron,cronexp="*/{{{fallback_minutes}}} * * * *",wake-system=false,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&timer_unit=minutes&action=auto&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"
#!REQUIREMENT "{{{fallback_enabled}}}=1 AND {{{fallback_minutes}}}=0 AND {{{fallback_hours}}}>0 AND {{{fallback_hours}}}<24" po0-firewall-timer-hours = type=cron,cronexp="0 */{{{fallback_hours}}} * * *",wake-system=false,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&timer_unit=hours&action=auto&exclude_cellular={{{exclude_cellular}}}&node_names={{{node_names}}}&node_keywords={{{node_keywords}}}&exclude_ssids={{{exclude_ssids}}}"

[Panel]
po0-firewall-status = script-name=po0-firewall-status,title=po0 状态 · 只读,content=点击刷新查询状态与槽位，不加白,icon=checkmark.shield,icon-color=#007AFF,update-interval=1
po0-firewall-add = script-name=po0-firewall-add,title=po0 手动加白,content=点击刷新执行加白,icon=checkmark.shield,icon-color=#007AFF,update-interval=1
#!REQUIREMENT "{{{show_network_panel}}}=1" po0-firewall-network-toggle = script-name=po0-firewall-network-toggle,title=po0 网络排除,content=自动识别当前 Wi-Fi 或蜂窝；点刷新切换是否排除,icon=wifi,icon-color=#007AFF,update-interval=1
