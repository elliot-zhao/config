#!name=po0 防火墙（按节点自动加白）
#!desc=只在连接 nodes 参数里的节点时自动加白，先查询再添加，避免挤掉 FIFO 名额。三个面板：状态查询（只读）、手动加白、排除当前网络。自动读取 SSID Setting 的挂起条件，也可用 exclude 参数排除网络。定时兜底：分钟优先，分钟为 0 时使用小时；开关为 0 时关闭定时兜底。
#!category=po0
#!requirement=CORE_VERSION>=6009000
#!arguments=tokens:"",nodes:"",exclude:"",fallback_enabled:1,fallback_minutes:30,fallback_hours:0,active_window:15,latency_test:0
#!arguments-desc=【tokens】po0 防火墙 token，多个用英文逗号分隔，可加后缀 @0~@4 固定槽位。\n\n【nodes】要检测的节点关键词，多个用 | 分隔，不区分大小写。例：po0|香港 IEPL|HK-01\n  只有这些节点在 active_window 分钟内有连接请求时才自动加白；不填则不自动加白（手动加白面板照常可用）。\n  多个 token 想各管各的节点，可在 token 后加「:关键词」，如 pgnfw_aaa@0:香港|HK, pgnfw_bbb:日本\n\n【exclude】不加白的网络，用 | 分隔：直接写 Wi-Fi 名（支持 * 通配），CELLULAR = 所有蜂窝网络，也支持 BSSID:xx、ROUTER:192.168.1.1、MCCMNC:46001。当前网络也可以在「po0 排除当前网络」面板一键排除。\n\n【fallback_enabled】1 开启定时兜底，0 关闭\n【fallback_minutes】每隔几分钟检查一次（0–59），大于 0 时优先使用\n【fallback_hours】分钟为 0 时，每隔几小时检查一次（0–23）\n\n【active_window】多少分钟内有连接请求算「在用节点」，默认 15\n\n【latency_test】1 = 测延迟也算在用节点（按节点延迟结果是否变化判断）；0 = 只认真实连接，默认 0\n\n参数值里不要包含 & 和英文双引号。

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-firewall-network = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&trigger=network&action=auto"
po0-firewall-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&trigger=start&action=auto"
po0-firewall-status = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&action=status"
po0-firewall-add = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&action=add"
po0-firewall-exclude = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&action=exclude"
po0-firewall-exclude-clear = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=10,argument="action=clear"
#!REQUIREMENT "{{{fallback_enabled}}}=1 AND {{{fallback_minutes}}}>0 AND {{{fallback_minutes}}}<60" po0-firewall-timer-minutes = type=cron,cronexp="*/{{{fallback_minutes}}} * * * *",wake-system=false,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&timer_unit=minutes&action=auto"
#!REQUIREMENT "{{{fallback_enabled}}}=1 AND {{{fallback_minutes}}}=0 AND {{{fallback_hours}}}>0 AND {{{fallback_hours}}}<24" po0-firewall-timer-hours = type=cron,cronexp="0 */{{{fallback_hours}}} * * *",wake-system=false,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-smart-whitelist.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&fallback_minutes={{{fallback_minutes}}}&fallback_hours={{{fallback_hours}}}&nodes={{{nodes}}}&exclude={{{exclude}}}&active_window={{{active_window}}}&latency_test={{{latency_test}}}&timer_unit=hours&action=auto"

[Panel]
po0-firewall-status = script-name=po0-firewall-status,title=po0 状态 · 只读,content=点击刷新查询状态与槽位，不加白,icon=checkmark.shield,icon-color=#007AFF,update-interval=1
po0-firewall-add = script-name=po0-firewall-add,title=po0 手动加白,content=点击刷新执行加白,icon=checkmark.shield,icon-color=#007AFF,update-interval=1
po0-firewall-exclude = script-name=po0-firewall-exclude,title=po0 排除当前网络,content=点击刷新：排除 / 恢复当前网络的自动加白,icon=wifi.slash,icon-color=#8E8E93,update-interval=1
