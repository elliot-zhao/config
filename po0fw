#!name=po0 防火墙（查询与加白）
#!desc=自动读取当前配置的 SSID Setting 挂起条件；状态查询与加白分成两个面板。原生 cron 按指定时刻执行；fallback_enabled=0 关闭兜底。
#!category=po0
#!arguments=tokens:"",fallback_enabled:1,fallback_cron:"*/30 * * * *"
#!arguments-desc=tokens：原 pgnfw_ token，多个用英文逗号分隔，可选 @0 至 @4。fallback_enabled：1 开启定时兜底，0 关闭。fallback_cron：填写 cron 表达式，默认 */30 * * * *；每6分钟填 */6 * * * *，每2小时填 0 */2 * * *。参数值无需外层引号。Wi-Fi 挂起条件自动读取。
#!requirement=CORE_VERSION>=6009000

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-firewall-network = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-firewall.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&action=auto"
po0-firewall-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-firewall.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&action=auto"
po0-firewall-status = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-firewall.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&action=status"
po0-firewall-add = type=generic,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-firewall.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&action=add"
# 由 Surge 原生 cron 直接调度；没有每分钟检查时间的额外任务。
# fallback_enabled=0：此 cron 禁用；=1：按 fallback_cron 指定的时刻执行。
# 即使关闭，也保留合法的 fallback_cron 表达式，不要将表达式本身填成 0。
#!REQUIREMENT {{{fallback_enabled}}}=1 po0-firewall-timer = type=cron,cronexp="{{{fallback_cron}}}",wake-system=false,script-path=https://raw.githubusercontent.com/elliot-zhao/config/refs/heads/main/po0-firewall.js,timeout=60,argument="tokens={{{tokens}}}&fallback_enabled={{{fallback_enabled}}}&action=auto"

[Panel]
po0-firewall-status = script-name=po0-firewall-status,title=po0 · 查询状态（只读）,content=点击刷新查询白名单与槽位，不执行加白,update-interval=1
po0-firewall-add = script-name=po0-firewall-add,title=po0 · 立即加白,content=点击本面板刷新按钮才执行加白,update-interval=1
